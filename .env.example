# =============================================================================
# Agentic AI Workshop - Customer parameters (EXAMPLE)
# -----------------------------------------------------------------------------
# 1) Copy this file:   cp .env.example .env
# 2) Replace the values for YOUR customer.
# 3) Every key here overrides the generic defaults in infrastructure/cdk.json
#    (key name in UPPER_CASE  ==  app_config key in lower_case).
# NOTE: .env is git-ignored. Never put secrets here.
# =============================================================================

# --- Deployment --------------------------------------------------------------
DEPLOYMENT_ENVIRONMENT=dev
AWS_REGION=us-east-1
# Prefix for every AWS resource (lowercase, digits and hyphens only)
RESOURCE_PREFIX=acme-agentic
# Deploy the static portal (S3 + CloudFront). Set to false in participant accounts
# if the facilitator hosts a single shared portal.
DEPLOY_FRONTEND=true

# --- Customer branding -------------------------------------------------------
# Folder inside ./customers/ with the knowledge base docs + mock banking data
# (create your own pack: cp -R customers/acme customers/<id>, it stays git-ignored)
CUSTOMER_ID=acme
CUSTOMER_NAME=ACME Corp
CUSTOMER_BRAND=ACME Bank
AGENT_NAME=AgentBot
AGENT_EMOJI=🤖
PRIMARY_COLOR=#FF9900
SECONDARY_COLOR=#232F3E
ACCENT_COLOR=#1A9C3E
WORKSHOP_TITLE=Agentic AI en AWS - Workshop Hands-On
WORKSHOP_DATE=
FACILITATOR_NAME=Santiago Garcia Arango
REPO_URL=https://github.com/san99tiago/aws-agentic-ai-fundamentals-workshop

# --- Models (Amazon Bedrock inference profiles) -------------------------------
# "us." = geographic profile (data stays in US regions); "global." = any commercial region
# (more capacity). Pick according to your data-residency requirements.
# Module 00 validates access. Some workshop accounts restrict newer models through a
# Private Marketplace (e.g. Sonnet/Opus 5.5): switch here, no code changes needed.
DEFAULT_MODEL_ID=global.anthropic.claude-sonnet-5
FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
TOP_MODEL_ID=us.anthropic.claude-opus-5
